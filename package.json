{
  "name": "archify-tiem-banh-may-tutorial",
  "version": "2.0.0",
  "private": true,
  "description": "Runnable bakery app used to teach evidence-first Archify diagramming",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node scripts/run-demo.js",
